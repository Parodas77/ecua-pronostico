# ==============================================================================
# ECUAPRONÓSTICO - VARIABLES DE ENTORNO PARA PRODUCCIÓN (VERCEL)
# ==============================================================================
# Copia estas variables en tu panel de Vercel:
# Settings -> Environment Variables -> Pegar (Ctrl + V)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WHATSAPP BUSINESS CLOUD API (META FOR DEVELOPERS)
# ------------------------------------------------------------------------------
# Token de verificación que tú configuras en el portal de Meta al registrar el webhook:
# Endpoint: https://tu-dominio.vercel.app/api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN="ecuapronostico_verify_token_2026"

# Token de acceso permanente de usuario del sistema (System User Token) de Meta Business Suite:
# Permisos requeridos: whatsapp_business_messaging, whatsapp_business_management
WHATSAPP_API_TOKEN="EAA..."

# Identificador del número de teléfono asignado por WhatsApp Cloud API (Phone Number ID):
# (Encuéntralo en Meta for Developers -> WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID="109283746500000"

# ------------------------------------------------------------------------------
# 2. MOTOR DE AUDITORÍA FINANCIERA CON IA (GOOGLE GEMINI VISION)
# ------------------------------------------------------------------------------
# Clave de API de Google Gemini (Google AI Studio: https://aistudio.google.com/)
# Utilizado por gemini-1.5-flash para OCR multimodal y extracción de comprobantes
GEMINI_API_KEY="AIzaSy..."

# ------------------------------------------------------------------------------
# 3. BASE DE DATOS POSTGRESQL (SUPABASE)
# ------------------------------------------------------------------------------
# URL base de tu proyecto en Supabase (Project Settings -> API):
SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"

# Clave secreta del servidor (Secret Key o Service Role Key):
# Permite al backend registrar usuarios y actualizar suscripciones sin bloqueos RLS
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Clave pública de publicación (Publishable Key / Anon Key):
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 4. APIS DE CUOTAS Y FÚTBOL EN VIVO (DATOS EXTERNOS)
# ------------------------------------------------------------------------------
# The Odds API (https://the-odds-api.com) para cuotas en vivo y cálculo de probabilidades de-vigged:
ODDS_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# API-Football (API-Sports: https://api-sports.io) para calendarios, planteles y árbitros:
API_FOOTBALL_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 5. CONFIGURACIÓN DEL DOMINIO
# ------------------------------------------------------------------------------
# URL pública canónica de la aplicación en producción (sin barra final):
NEXT_PUBLIC_BASE_URL="https://ecua-pronostico-git-main-parodas77-8597s-projects.vercel.app"
